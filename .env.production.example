# ===== Prisma + NextAuth =====
# Postgres（容器内走 docker 网络，主机名是 docker-compose 里的 service 名）
DATABASE_URL="postgresql://woning:woning@db:5432/woning?schema=public"

# ===== NextAuth =====
NEXTAUTH_URL="https://woning.example.com"
NEXTAUTH_SECRET="CHANGE-ME-32+chars-random-base64"

# ===== 初始 admin（仅 seed 使用） =====
ADMIN_EMAIL="admin@woning.local"
ADMIN_PASSWORD="CHANGE-ME-strong-password"
ADMIN_NAME="初始管理员"

# ===== 上传限制（字节） =====
MAX_IMAGE_SIZE="10485760"
MAX_VIDEO_SIZE="209715200"

# ===== 应用端口（容器内） =====
PORT="3000"
HOSTNAME="0.0.0.0"